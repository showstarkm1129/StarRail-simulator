{
  "name": "starrail-simulator",
  "version": "1.0.0",
  "private": true,
  "description": "崩壊スターレイル ビルド/火力シミュレーター (Vanilla HTML/CSS/JS, ES Modules)",
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "audit:characters": "node scripts/audit-character-effects.mjs",
    "upsert:character-effect": "node scripts/upsert-character-effect.mjs",
    "check": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --test",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:debug": "playwright test --debug",
    "e2e:install": "playwright install chromium",
    "e2e:report": "playwright show-report",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include=\"js/build/**\" --test-coverage-lines=90 --test-coverage-functions=92 --test-coverage-branches=65",
    "verify": "npm run check && npm run lint && npm run coverage && npm run e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.4.0"
  }
}
