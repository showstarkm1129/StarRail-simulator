{
  "name": "starrail-simulator",
  "version": "1.0.0",
  "private": true,
  "description": "崩壊スターレイル ビルド/火力シミュレーター (Vanilla HTML/CSS/JS, ES Modules)",
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "check": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --test",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include=\"js/build/**\" --test-coverage-lines=90 --test-coverage-functions=92 --test-coverage-branches=65",
    "verify": "npm run check && npm run lint && npm run coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.4.0"
  }
}
